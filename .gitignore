# ROS 2 / colcon 生成的构建、安装和日志目录
/build/
/install/
/log/

# 本地编辑器和 Codex/Agent 工作区配置
/.vscode/
/.agents/
/.codex/

# CMake / 编译数据库生成文件
/compile_commands.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Python 缓存（ROS 2 工具链可能生成）
__pycache__/
*.py[cod]

# 本地实验结果（CSV、日志和分析结果）
/exp/

# 提交 Phase 11 的公开参考数据和图表，其余 exp 内容保持本地忽略
/exp/*
!/exp/
!/exp/raw/
/exp/raw/*
!/exp/raw/phase11/
!/exp/raw/phase11/**
!/exp/plots/
!/exp/plots/**

# 操作系统和编辑器临时文件
.DS_Store
*.swp
*~
